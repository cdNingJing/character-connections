{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Connections document v1",
  "type": "object",
  "required": ["schemaVersion", "title", "characters", "relations"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "maxChapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "name", "group"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "y": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              }
            }
          },
          "placement": {
            "type": "object",
            "required": ["level", "order"],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": -20,
                "maximum": 20
              },
              "order": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "label", "type"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "directed": {
            "type": "boolean"
          },
          "fromChapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "toChapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        }
      }
    },
    "appearance": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "edgeColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "pattern": {
          "enum": ["dots", "grid", "none"]
        },
        "backgroundImage": {
          "type": "string",
          "maxLength": 3145728,
          "pattern": "^$|^data:image/(png|jpeg|webp);base64,[a-zA-Z0-9+/=]+$"
        },
        "edgeShape": {
          "enum": ["bezier", "straight", "round-taxi"]
        },
        "edgeLine": {
          "enum": ["solid", "dashed", "dotted"]
        },
        "edgeWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "unifiedEdgeColor": {
          "type": "boolean"
        },
        "arrows": {
          "type": "boolean"
        },
        "transition": {
          "enum": ["none", "smooth", "fade"]
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "labels": {
          "enum": ["related", "all", "none"]
        }
      }
    },
    "coreId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
