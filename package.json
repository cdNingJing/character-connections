{
  "name": "character-connections",
  "version": "0.3.0",
  "description": "Deterministic character relationship graphs with Journey to the West progressive examples",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build --base=./ && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "format": "prettier --write src tests scripts examples index.html README.md CONTRIBUTING.md docs schema.json package.json tsconfig.json",
    "examples": "node --experimental-strip-types scripts/generate-examples.mjs"
  },
  "dependencies": {
    "cytoscape": "^3.34.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdNingJing/character-connections.git"
  },
  "homepage": "https://github.com/cdNingJing/character-connections#readme",
  "bugs": {
    "url": "https://github.com/cdNingJing/character-connections/issues"
  }
}
