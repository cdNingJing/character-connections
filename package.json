{
  "name": "character-connections",
  "version": "0.6.0",
  "description": "Deterministic character relationship graphs with Journey to the West progressive examples",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:lib && npm pack --ignore-scripts --pack-destination dist && vite --host 127.0.0.1 --port 4180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build --base=./ && node scripts/build-standalone.mjs && npm run build:lib && npm pack --ignore-scripts --pack-destination dist && npm run test:types",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "format": "prettier --write src tests scripts examples index.html workbench.html README.md CONTRIBUTING.md docs schema.json package.json tsconfig*.json vite*.ts",
    "examples": "node --experimental-strip-types scripts/generate-examples.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-declarations.mjs",
    "prepack": "npm run build:lib",
    "test:types": "tsc -p tests/consumer/tsconfig.json",
    "test:consumer": "vite tests/consumer --host 127.0.0.1 --port 4182 --strictPort"
  },
  "dependencies": {
    "cytoscape": "^3.34.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdNingJing/character-connections.git"
  },
  "homepage": "https://github.com/cdNingJing/character-connections#readme",
  "bugs": {
    "url": "https://github.com/cdNingJing/character-connections/issues"
  },
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/lib",
    "schema.json",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/component-api.md",
    "docs/data-format.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./element": {
      "types": "./dist/lib/types/element.d.ts",
      "import": "./dist/lib/element.js"
    },
    "./style.css": {
      "types": "./dist/lib/types/graph.css.d.ts",
      "default": "./dist/lib/character-connections.css"
    },
    "./schema.json": "./schema.json"
  }
}
